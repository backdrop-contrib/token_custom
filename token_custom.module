/**
 * Implements hook_token_info().
 */
function token_custom_token_info() {
  $token_info = array();

  // Load custom types.
  foreach (token_custom_type_load_multiple() as $type) {
    $token_info['types'][$type->machine_name] = array(
      'name' => check_plain($type->name),
      'description' => check_plain($type->description),
    );
  }

  // Load individual tokens.
  foreach (token_custom_load_multiple() as $token) {
    $token_info['tokens'][$token->type][$token->machine_name] = array(
      'name' => check_plain($token->name),
      'description' => check_plain($token->description),
    );
  }

  return $token_info;
}

/**
 * Implements hook_tokens().
 */
function token_custom_tokens($type, $tokens, array $data = array(), array $options = array()) {
  $replacements = array();
  $custom_tokens = token_custom_load_multiple();

  foreach ($tokens as $name => $original) {
    if (isset($custom_tokens[$name]) && $custom_tokens[$name]->type == $type) {
      $replacements[$original] = token_custom_token_render($name, $custom_tokens[$name]->content, $data, $options);
    }
  }

  return $replacements;
}

/**
 * Evaluates and renders a custom token.
 *
 * @param string $machine_name
 * The machine name of the token.
 * @param string $content
 * The raw content of the token.
 * @param array $data
 * Data for replacement.
 * @param array $options
 * Options for replacement.
 *
 * @return string
 * The rendered output.
 */
function token_custom_token_render($machine_name, $content, $data, $options) {
  $token = token_custom_load($machine_name);
  if (!$token) {
    return '';
  }

  // Replace any nested tokens found within the custom content.
  $rendered = token_replace($content, $data, $options);

  // Apply the text format (HTML filtering).
  return check_markup($rendered, $token->format);
}

/**
 * Access callback for token type forms.
 *
 * @param object $type
 * The token type to check access for.
 *
 * @return bool
 * TRUE if access is granted.
 */
function token_custom_type_forms_access($type) {
  return user_access('administer custom tokens') && $type->machine_name != TOKEN_CUSTOM_DEFAULT_TYPE;
}

/**
 * Implements hook_config_info().
 */
function token_custom_config_info() {
  $prefixes['token_custom.settings'] = array(
    'label' => t('Custom tokens settings'),
    'group' => t('Configuration'),
  );
  return $prefixes;
}

/**
 * Load all custom types from config.
 *
 * @return array
 * An array of token type objects.
 */
function token_custom_type_load_multiple() {
  $types = config_get('token_custom.settings', 'token_custom_types');

  if (!isset($types[TOKEN_CUSTOM_DEFAULT_TYPE])) {
    $default_type = new stdClass();
    $default_type->name = t('Custom');
    $default_type->machine_name = TOKEN_CUSTOM_DEFAULT_TYPE;
    $default_type->description = t('User created tokens.');
    $types[TOKEN_CUSTOM_DEFAULT_TYPE] = $default_type;
  }

  return $types;
}

/**
 * Load a single custom type.
 *
 * @param string $type
 * The machine name of the type.
 *
 * @return object|bool
 * The type object or FALSE.
 */
function token_custom_type_load($type) {
  $types = token_custom_type_load_multiple();
  return isset($types[$type]) ? $types[$type] : FALSE;
}

/**
 * Save a custom type to config.
 *
 * @param object $type
 * The type object to save.
 */
function token_custom_type_save($type) {
  if ($type->machine_name == TOKEN_CUSTOM_DEFAULT_TYPE) {
    return FALSE;
  }
  $types = token_custom_type_load_multiple();
  $types[$type->machine_name] = $type;
  config_set('token_custom.settings', 'token_custom_types', $types);
  return $type;
}

/**
 * Delete a custom type.
 *
 * @param string $delete_type
 * The machine name of the type to delete.
 */
function token_custom_type_delete($delete_type) {
  if ($delete_type == TOKEN_CUSTOM_DEFAULT_TYPE) {
    return FALSE;
  }

  $types = token_custom_type_load_multiple();
  if (!isset($types[$delete_type])) {
    return FALSE;
  }

  // Reassign tokens of this type to the default 'custom' type.
  db_update('token_custom')
    ->fields(array('type' => TOKEN_CUSTOM_DEFAULT_TYPE))
    ->condition('type', $delete_type)
    ->execute();

  unset($types[$delete_type]);
  config_set('token_custom.settings', 'token_custom_types', $types);

  return TRUE;
}

/**
 * Save a token to the database.
 *
 * @param object $token
 * The token object to save.
 *
 * @return bool
 * TRUE on success.
 */
function token_custom_save($token) {
  $is_new = !empty($token->is_new);
  unset($token->is_new);
  return (bool) backdrop_write_record('token_custom', $token, $is_new ? array() : 'machine_name');
}

/**
 * Load a single token.
 *
 * @param string $machine_name
 * The machine name of the token.
 *
 * @return object|null
 * The token object or NULL.
 */
function token_custom_load($machine_name) {
  $tokens = token_custom_load_multiple(array($machine_name));
  return array_shift($tokens);
}

/**
 * Load multiple tokens from DB with static caching.
 *
 * @param array $names
 * An optional array of machine names to load.
 *
 * @return array
 * An array of token objects.
 */
function token_custom_load_multiple($names = NULL) {
  /** @var array $cache */
  $cache = &backdrop_static(__FUNCTION__, array());

  if ($names === NULL) {
    $query = db_select('token_custom')->fields('token_custom');
    $results = $query->execute();
    foreach ($results as $token) {
      $cache[$token->machine_name] = $token;
    }
    return $cache;
  }

  $to_fetch = array_diff($names, array_keys($cache));
  if (!empty($to_fetch)) {
    $results = db_select('token_custom')
      ->fields('token_custom')
      ->condition('machine_name', $to_fetch, 'IN')
      ->execute();
    foreach ($results as $token) {
      $cache[$token->machine_name] = $token;
    }
  }

  return array_intersect_key($cache, array_flip($names));
}

/**
 * Delete a token.
 *
 * @param string $machine_name
 * The machine name of the token to delete.
 */
function token_custom_delete($machine_name) {
  return db_delete('token_custom')
    ->condition('machine_name', $machine_name)
    ->execute();
}
