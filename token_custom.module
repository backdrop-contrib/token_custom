<?php

/**
 * @file
 * Allows users to create custom tokens for specific replacements.
 */

/**
 * The default token type machine name.
 */
define('TOKEN_CUSTOM_DEFAULT_TYPE', 'custom');

/**
 * Implements hook_help().
 */
function token_custom_help($path, $arg) {
  switch ($path) {
    case 'admin/help#token_custom':
      $output = '<p>'
              . t("This allows you to create custom tokens for use throughout the site using the <a href='@admin_url'>administration pages</a>.",
                  array('@admin_url' => url('admin/structure/token-custom')))
              . '</p>';
      $output .= '<p>'
              . t('Tokens can be created using markup and can nest other tokens inside them.')
              . '</p>';
      return $output;
  }
}

/**
 * Implements hook_permission().
 */
function token_custom_permission() {
  return array(
    'administer custom tokens' => array(
      'title' => t('Administer custom tokens'),
      'description' => t('Create, edit, and delete custom tokens.'),
      'restrict access' => TRUE,
    ),
    'list custom tokens' => array(
      'title' => t("Access the custom token administration page"),
      'description' => t('View the list of available custom tokens.'),
    ),
  );
}

